{
  "compilerOptions": {
    "jsx": "react",
    "paths": {
      "@stet-css/cli": [ "./node_modules/@stet-css/cli/src" ],
      "@stet-css/compiler": [ "./node_modules/@stet-css/compiler/src" ],
      "@stet-css/compiler/*": [ "./node_modules/@stet-css/compiler/src/*" ],
      "@stet-css/diagnostics": [ "./node_modules/@stet-css/diagnostics/src" ],
      "@stet-css/engine": [ "./node_modules/@stet-css/engine/src" ],
      "@stet-css/engine/*": [ "./node_modules/@stet-css/engine/src/*" ],
      "@stet-css/preset": [ "./node_modules/@stet-css/preset/src" ],
      "@stet-css/preset/*": [ "./node_modules/@stet-css/preset/src/*" ],
      "@stet-css/core": [ "./node_modules/@stet-css/core/src" ],
      "@stet-css/core/*": [ "./node_modules/@stet-css/core/src/*" ],
      "@stet-css/eslint-config": [ "./node_modules/@stet-css/eslint-config/src" ],
      "@stet-css/eslint-plugin": [ "./node_modules/@stet-css/eslint-plugin/src" ],
      "@stet-css/scanner": [ "./node_modules/@stet-css/scanner/src" ],
      "@stet-css/scanner/*": [ "./node_modules/@stet-css/scanner/src/*" ],
      "@stet-css/integration": [ "./node_modules/@stet-css/integration/src" ],
      "@stet-css/integration/*": [ "./node_modules/@stet-css/integration/src/*" ],
      "@stet-css/schema": [ "./node_modules/@stet-css/schema/src" ],
      "@stet-css/schema/*": [ "./node_modules/@stet-css/schema/src/*" ],
      "@stet-css/vite": [ "./node_modules/@stet-css/vite/src" ],
      "@stet-css/webpack": [ "./node_modules/@stet-css/webpack/src" ],
      "@stet-css/language": [ "./node_modules/@stet-css/language/src" ],
      "@stet-css/language/*": [ "./node_modules/@stet-css/language/src/*" ],
      "@stet-css/language-server": [ "./node_modules/@stet-css/language-server/src" ],
      "@stet-css/language-service": [ "./node_modules/@stet-css/language-service/src" ],
      "@stet-css/language-service/*": [ "./node_modules/@stet-css/language-service/src/*" ],
      "@stet-css/lexer": [ "./node_modules/@stet-css/lexer/src" ],
      "@stet-css/lexer/*": [ "./node_modules/@stet-css/lexer/src/*" ],
      "@stet-css/lint": [ "./node_modules/@stet-css/lint/src" ],
      "@stet-css/source": [ "./node_modules/@stet-css/source/src" ],
      "@stet-css/source/*": [ "./node_modules/@stet-css/source/src/*" ],
      "@stet-css/stylesheet": [ "./node_modules/@stet-css/stylesheet/src" ],
      "@stet-css/stylesheet/*": [ "./node_modules/@stet-css/stylesheet/src/*" ],
      "@stet-css/project": [ "./node_modules/@stet-css/project/src/manifest" ],
      "@stet-css/project/*": [ "./node_modules/@stet-css/project/src/*" ],
      "@stet-css/nuxt": [ "./node_modules/@stet-css/nuxt/src/module.ts" ],
      "@stet-css/next": [ "./node_modules/@stet-css/next/src" ],
      "@stet-css/runtime": [ "./node_modules/@stet-css/runtime/src" ],
      "@stet-css/server": [ "./node_modules/@stet-css/server/src" ],
      "@stet-css/svelte/*": [ "./node_modules/@stet-css/svelte/src/lib/*" ],
      "@stet-css/validator": [ "./node_modules/@stet-css/validator/src" ],
      "@stet-css/validator/*": [ "./node_modules/@stet-css/validator/src/*" ],
      "@stet-css/astro": [ "./node_modules/@stet-css/astro/src" ],
      "master-css-vscode": [ "./node_modules/master-css-vscode/src" ],
      "~/*": [ "./*" ],
    },
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
