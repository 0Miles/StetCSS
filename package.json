{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "trustedDependencies": [
    "@firebase/util",
    "@parcel/watcher",
    "@swc/core",
    "@vscode/vsce-sign",
    "esbuild",
    "keytar",
    "lmdb",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "scripts": {
    "build": "node scripts/with-typescript-tooling-compat.mjs turbo run build --filter=\"./packages/*\"",
    "build:examples": "node scripts/with-typescript-tooling-compat.mjs turbo run build --filter=\"./examples/*\"",
    "release:vscode": "node packages/vscode/scripts/release.js",
    "check": "node scripts/with-typescript-tooling-compat.mjs turbo run test lint type-check --filter=\"./packages/*\"",
    "test": "node scripts/with-typescript-tooling-compat.mjs turbo run test --filter=\"./packages/*\"",
    "e2e": "node scripts/with-typescript-tooling-compat.mjs turbo run e2e --filter=\"./packages/*\" --filter=\"!@stet-css/runtime\" --concurrency=1 && bun run --filter @stet-css/runtime e2e",
    "lint": "node scripts/with-typescript-tooling-compat.mjs turbo run lint --filter=\"./packages/*\"",
    "type-check": "node scripts/with-typescript-tooling-compat.mjs turbo run type-check --filter=\"./packages/*\"",
    "type-check:refs": "tsc -b tsconfig.typecheck.json",
    "type-check:clean": "tsc -b tsconfig.typecheck.json --clean",
    "type-check:affected": "turbo run type-check --affected"
  },
  "engines": {
    "node": "^24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0Miles/StetCSS.git"
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/cli": "workspace:^",
    "@stet-css/compiler": "workspace:^",
    "@stet-css/diagnostics": "workspace:^",
    "@stet-css/engine": "workspace:^",
    "@stet-css/integration": "workspace:^",
    "@stet-css/language": "workspace:^",
    "@stet-css/language-server": "workspace:^",
    "@stet-css/language-service": "workspace:^",
    "@stet-css/lexer": "workspace:^",
    "@stet-css/lint": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "@stet-css/project": "workspace:^",
    "@stet-css/runtime": "workspace:^",
    "@stet-css/scanner": "workspace:^",
    "@stet-css/schema": "workspace:^",
    "@stet-css/server": "workspace:^",
    "@stet-css/source": "workspace:^",
    "@stet-css/stylesheet": "workspace:^",
    "@stet-css/validator": "workspace:^",
    "@stet-css/next": "workspace:^",
    "@stet-css/nuxt": "workspace:^",
    "@stet-css/svelte": "workspace:^",
    "@stet-css/vite": "workspace:^",
    "@stet-css/webpack": "workspace:^",
    "@stet-css/eslint-config": "workspace:^",
    "@stet-css/eslint-plugin": "workspace:^"
  },
  "devDependencies": {
    "@ts-macro/tsc": "^0.3.7",
    "@types/edit-json-file": "^1.7.4",
    "concurrently": "^9.2.3",
    "master-css-vscode": "workspace:^",
    "tsdown": "^0.22.4",
    "turbo": "~2.10.13",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@swc-node/jest": "^1.9.1",
    "@types/node": "^25.9.4",
    "@types/node-fetch": "^2.6.13",
    "@types/shuffle-array": "^1.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "edit-json-file": "^1.8.1",
    "eslint": "^10.6.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "get-tsconfig": "^4.14.0",
    "globals": "^17.7.0",
    "jest-extended": "^7.0.0",
    "jest-text-transformer": "^1.0.4",
    "js-beautify": "^1.15.4",
    "nanoid": "^5.1.16",
    "nodemon": "^3.1.14",
    "shuffle-array": "^1.0.1",
    "strip-ansi": "^7.2.0",
    "tinybench": "^6.0.2",
    "ts-dedent": "^2.3.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "typescript6": "npm:typescript@6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks",
    "shared"
  ],
  "overrides": {
    "rolldown-plugin-dts": "0.27.4"
  }
}
