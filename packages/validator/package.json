{
  "name": "@stet-css/validator",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Validate generated StetCSS classes and rules",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/validator#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/validator"
  },
  "keywords": [
    "classes",
    "class",
    "validator",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native-declaration": {
      "types": "./dist/native-declaration.d.ts",
      "import": "./dist/native-declaration.js",
      "default": "./dist/native-declaration.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/compiler": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "css-tree": "^3.2.1",
    "@stet-css/schema": "workspace:^"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "ts-jest": "^29.4.11"
  }
}
