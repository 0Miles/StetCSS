{
  "name": "@stet-css/engine",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "The manifest-driven StetCSS engine",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/engine"
  },
  "keywords": [
    "style",
    "styles",
    "html",
    "variants",
    "virtual",
    "virtual-css",
    "utility",
    "css",
    "ui",
    "lightweight",
    "class",
    "webpack",
    "plugin",
    "integration",
    "vite",
    "parcel",
    "build-tools",
    "stetcss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js",
      "default": "./dist/compiler.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "default": "./dist/inspect.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/lexer": "workspace:^",
    "csstype": "^3.2.3",
    "@stet-css/schema": "workspace:^"
  },
  "devDependencies": {
    "@stet-css/preset": "workspace:^",
    "mdn-data": "^2.28.1"
  }
}
