{
  "name": "@stet-css/eslint-config",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest",
    "lint": "eslint src *.js"
  },
  "keywords": [
    "stetcss",
    "eslint",
    "eslintconfig"
  ],
  "license": "MIT",
  "description": "StetCSS ESLint Configuration",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/eslint-config"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/eslint-plugin": "workspace:^"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.4.0",
    "eslint": "^10.5.0"
  }
}
