{
  "name": "@stet-css/preset",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "bun run generate",
    "generate": "node --import tsx scripts/generate-default-manifest.ts",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "The default StetCSS preset source and compiled manifest.",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/preset#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "preset",
    "css",
    "stetcss"
  ],
  "sideEffects": [
    "./src/*.css"
  ],
  "style": "./src/index.css",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./default-manifest.json": {
      "types": "./src/default-manifest.json.d.ts",
      "import": "./src/default-manifest.json",
      "default": "./src/default-manifest.json"
    },
    "./index.css": "./src/index.css",
    "./base.css": "./src/base.css",
    "./theme.css": "./src/theme.css",
    "./variants.css": "./src/variants.css",
    "./utilities.css": "./src/utilities.css"
  },
  "files": [
    "src/*.css",
    "src/default-manifest.json",
    "src/default-manifest.json.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/schema": "workspace:^"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
