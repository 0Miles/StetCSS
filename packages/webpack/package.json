{
  "name": "@stet-css/webpack",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Webpack plugin for StetCSS",
  "author": "Aoyue Design LLC.",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/webpack#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/webpack"
  },
  "keywords": [
    "webpack",
    "plugin",
    "integration",
    "build tools",
    "css",
    "stetcss",
    "webpack-plugin"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "webpack": ">=5"
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/scanner": "workspace:^",
    "@stet-css/integration": "workspace:^",
    "@stet-css/project": "workspace:^",
    "@stet-css/stylesheet": "workspace:^",
    "webpack-virtual-modules": "^0.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "tapable": "^2.3.3",
    "webpack": "^5.107.2"
  }
}
