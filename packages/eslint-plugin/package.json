{
  "name": "@stet-css/eslint-plugin",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "vitest",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "keywords": [
    "stetcss",
    "eslint",
    "eslintplugin"
  ],
  "license": "MIT",
  "description": "StetCSS ESLint Plugin",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/eslint-plugin"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./configs/*": {
      "types": "./dist/configs/*.d.ts",
      "import": "./dist/configs/*.js",
      "default": "./dist/configs/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/lexer": "workspace:^",
    "@stet-css/lint": "workspace:^",
    "@stet-css/project": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "@stet-css/validator": "workspace:^",
    "@typescript-eslint/utils": "^8.61.1",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.4.0",
    "@stet-css/schema": "workspace:^",
    "@angular/compiler": "^21.2.17",
    "@typescript-eslint/rule-tester": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-mdx": "^3.8.1",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mdx": "^3.8.1",
    "svelte-eslint-parser": "^1.8.0",
    "ts-node": "^10.9.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
