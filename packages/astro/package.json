{
  "name": "@stet-css/astro",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "vitest",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Astro integration for StetCSS",
  "author": "Aoyue Design LLC.",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/astro"
  },
  "keywords": [
    "plugin",
    "integration",
    "astro",
    "build tools",
    "static rendering",
