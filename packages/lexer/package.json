{
  "name": "@stet-css/lexer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Dependency-free lexical source scanners for StetCSS tooling",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/lexer#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/lexer"
  },
  "keywords": [
    "lexer",
    "scanner",
    "classes",
    "directives",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./character-reference": {
      "types": "./dist/character-reference.d.ts",
      "import": "./dist/character-reference.js",
      "default": "./dist/character-reference.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "./character-reference": [
        "./dist/character-reference.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
