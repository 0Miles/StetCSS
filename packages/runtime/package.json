{
  "name": "@stet-css/runtime",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "bench": "node scripts/benchmark-runtime.js",
    "dev": "tsdown --watch",
    "e2e": "playwright test",
    "e2e:watch": "nodemon -e js,ts,html,css --watch dist --watch e2e --watch tests --exec playwright test",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Browser runtime for StetCSS",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "utility",
    "css",
    "lightweight",
    "stetcss",
    "runtime",
    "cdn"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/global.min.js",
  "unpkg": "./dist/global.min.js",
  "jsdelivr": "./dist/global.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./dist/index.development.js",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/engine": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "@stet-css/schema": "workspace:^"
  },
  "devDependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/compiler": "workspace:^",
    "@stet-css/integration": "workspace:^",
    "@playwright/test": "1.61.0"
  }
}
