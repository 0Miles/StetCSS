{
  "name": "@stet-css/svelte",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint --pack false",
    "prepublishOnly": "bun run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Svelte and SvelteKit integration for StetCSS",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "svelte": ">=4",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@stet-css/vite": "workspace:^"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-svelte": "^1.58.2",
    "@playwright/test": "^1.61.0",
    "@stet-css/core": "workspace:^",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
