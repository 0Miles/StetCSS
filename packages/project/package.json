{
  "name": "@stet-css/project",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "StetCSS project entry discovery and manifest loading utilities.",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/project#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/project"
  },
  "keywords": [
    "project",
    "manifest",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "types": "./dist/manifest.d.ts",
  "exports": {
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest-sync": {
      "types": "./dist/manifest-sync.d.ts",
      "import": "./dist/manifest-sync.js",
      "default": "./dist/manifest-sync.js"
    },
    "./entries": {
      "types": "./dist/entries.d.ts",
      "import": "./dist/entries.js",
      "default": "./dist/entries.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js",
      "default": "./dist/sources.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/compiler": "workspace:^",
    "@stet-css/integration": "workspace:^",
    "@stet-css/lexer": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "@stet-css/schema": "workspace:^"
  }
}
