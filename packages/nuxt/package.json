{
  "name": "@stet-css/nuxt",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build && node scripts/normalize-module-build.js",
    "dev": "nuxt-module-build prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && node scripts/normalize-module-build.js && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "license": "MIT",
  "description": "Nuxt module for StetCSS",
  "author": "Aoyue Design LLC.",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/nuxt#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "vue",
    "css",
    "nuxt",
    "stetcss",
    "static"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    }
  },
  "main": "./dist/module.js",
  "module": "./dist/module.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/vite": "workspace:^",
    "@nuxt/kit": "^4.4.8"
  },
  "peerDependencies": {
    "nuxt": ">=4",
    "@nuxt/schema": ">=4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-alpha.4",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/js-beautify": "^1.14.3",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "js-beautify": "^1.15.4",
    "nuxt": "^4.4.8",
    "playwright-core": "^1.61.0",
    "unbuild": "^3.6.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.38"
  }
}
