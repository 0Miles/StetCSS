{
  "name": "@stet-css/lint",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "keywords": [
    "stetcss",
    "lint",
    "classes",
    "css"
  ],
  "license": "MIT",
  "description": "Framework-neutral StetCSS lint policy helpers",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/lint",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/lint"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/engine": "workspace:^",
    "@stet-css/language": "workspace:^",
    "@stet-css/lexer": "workspace:^",
    "@stet-css/schema": "workspace:^",
    "@stet-css/validator": "workspace:^"
  },
  "devDependencies": {
    "@stet-css/preset": "workspace:^"
  }
}
