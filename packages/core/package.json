{
  "name": "@stet-css/core",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "StetCSS: a markup-driven CSS engine where classes compile to CSS rules",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/core"
  },
  "keywords": [
    "style",
    "styles",
    "html",
    "variants",
    "virtual",
    "virtual-css",
    "utility",
    "css",
    "ui",
    "lightweight",
    "class",
    "webpack",
    "plugin",
    "integration",
    "vite",
    "parcel",
    "build-tools",
    "stetcss"
  ],
  "sideEffects": [
    "./src/*.css"
  ],
  "main": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./src/index.css",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.css": "./src/index.css",
    "./base.css": "./src/base.css",
    "./theme.css": "./src/theme.css",
    "./variants.css": "./src/variants.css",
    "./utilities.css": "./src/utilities.css"
  },
  "files": [
    "dist",
    "src/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/engine": "workspace:^",
    "@stet-css/preset": "workspace:^"
  }
}
