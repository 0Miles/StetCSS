{
  "name": "stet-css-vscode",
  "type": "module",
  "scripts": {
    "build": "tsdown && bun run generate",
    "generate": "node --import tsx generate",
    "dev": "tsdown --watch",
    "test": "vitest",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "vscode:package": "node scripts/package-targets.js package",
    "vscode:publish": "node scripts/package-targets.js publish",
    "release": "node scripts/release.js"
  },
  "version": "2.0.36",
  "description": "StetCSS for Visual Studio Code",
  "displayName": "StetCSS",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/vscode#readme",
  "license": "MIT",
  "publisher": "stet-css",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.min.js",
  "exports": {
    ".": "./dist/extension.min.js",
    "./server": "./dist/server.min.js"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "icon.png"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Using StetCSS is not possible in virtual workspaces."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension requires workspace trust because it loads configuration files and code from the workspace and executes it."
    }
  },
  "contributes": {
    "commands": [
      {
        "title": "Restart Language Server",
        "command": "stetCSS.restart",
        "category": "StetCSS"
      }
    ],
    "configuration": {
      "title": "StetCSS",
      "properties": {
        "stetCSS.includedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "html",
            "php",
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
            "css",
            "scss",
            "less",
            "vue",
            "svelte",
            "rust",
            "astro",
            "markdown",
            "mdx",
            "astro"
          ]
        },
        "stetCSS.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.hg/**"
          ],
          "description": "Configure glob patterns to exclude from all StetCSS language-service features."
        },
        "stetCSS.classAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "class",
            "className"
          ]
        },
        "stetCSS.classAttributeBindings": {
          "type": "object",
          "default": {
            "className": [
              "{",
              "}"
            ],
            "class": [
              "{",
              "}"
            ],
            "class:list": [
              "{",
              "}"
            ],
            ":class": [
              "\"",
              "\""
            ],
            "v-bind:class": [
              "\"",
              "\""
            ],
            "[class]": [
              "\"",
              "\""
            ],
            "[className]": [
              "\"",
              "\""
            ],
            "[ngClass]": [
              "\"",
              "\""
            ]
          }
        },
        "stetCSS.classDeclarations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stetCSS.classFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "clsx",
            "cva",
            "ctl",
            "cv",
            "class",
            "classnames",
            "classVariant",
            "styled(?:\\s+)?(?:\\.\\w+)?",
            "classList(?:\\s+)?\\.(?:add|remove|toggle|replace)"
          ]
        },
        "stetCSS.suggestSyntax": {
          "type": "boolean",
          "default": true
        },
        "stetCSS.inspectSyntax": {
          "type": "boolean",
          "default": true
        },
        "stetCSS.renderSyntaxColors": {
          "type": "boolean",
          "default": true
        },
        "stetCSS.formatDirectives": {
          "type": "boolean",
          "default": true,
          "description": "Enables StetCSS directive formatting in CSS-family documents."
        },
        "stetCSS.embeddedSyntaxHighlighting": {
          "type": "string",
          "enum": [
            "active",
            "always",
            "off"
          ],
          "default": "active",
          "description": "Controls embedded StetCSS utility highlighting in markup and scripts. Active highlights the class context at the active editor selection, always highlights all discovered embedded utilities, and off disables embedded utility highlighting. StetCSS syntax inside CSS documents is always highlighted."
        },
        "stetCSS.workspaces": {
          "type": [
            "string",
            "array"
          ],
          "default": "auto",
          "description": "Configure StetCSS workspaces. The default auto mode detects CSS files with @import \"@stet-css/core\" and package.json files that declare StetCSS package dependencies."
        }
      }
    },
    "semanticTokenModifiers": [
      {
        "id": "component",
        "description": "StetCSS component semantic token modifier."
      },
      {
        "id": "directive",
        "description": "StetCSS directive semantic token modifier."
      },
      {
        "id": "important",
        "description": "StetCSS important semantic token modifier."
      },
      {
        "id": "pseudoClass",
        "description": "StetCSS pseudoClass semantic token modifier."
      },
      {
        "id": "pseudoElement",
        "description": "StetCSS pseudoElement semantic token modifier."
      },
      {
        "id": "query",
        "description": "StetCSS query semantic token modifier."
      },
      {
        "id": "quoted",
        "description": "StetCSS quoted semantic token modifier."
      },
      {
        "id": "selector",
        "description": "StetCSS selector semantic token modifier."
      },
      {
        "id": "unit",
        "description": "StetCSS unit semantic token modifier."
      },
      {
        "id": "blockBrace",
        "description": "StetCSS blockBrace semantic token modifier."
      },
      {
        "id": "declarationSeparator",
        "description": "StetCSS declarationSeparator semantic token modifier."
      },
      {
        "id": "declarationTerminator",
        "description": "StetCSS declarationTerminator semantic token modifier."
      },
      {
        "id": "directiveTerminator",
        "description": "StetCSS directiveTerminator semantic token modifier."
      },
      {
        "id": "functionPunctuation",
        "description": "StetCSS functionPunctuation semantic token modifier."
      },
      {
        "id": "valueSeparator",
        "description": "StetCSS valueSeparator semantic token modifier."
      },
      {
        "id": "valueOperator",
        "description": "StetCSS valueOperator semantic token modifier."
      },
      {
        "id": "queryOperator",
        "description": "StetCSS queryOperator semantic token modifier."
      },
      {
        "id": "queryPunctuation",
        "description": "StetCSS queryPunctuation semantic token modifier."
      },
      {
        "id": "selectorCombinator",
        "description": "StetCSS selectorCombinator semantic token modifier."
      },
      {
        "id": "selectorPunctuation",
        "description": "StetCSS selectorPunctuation semantic token modifier."
      },
      {
        "id": "pseudoClassDelimiter",
        "description": "StetCSS pseudoClassDelimiter semantic token modifier."
      },
      {
        "id": "pseudoElementDelimiter",
        "description": "StetCSS pseudoElementDelimiter semantic token modifier."
      },
      {
        "id": "attributeOperator",
        "description": "StetCSS attributeOperator semantic token modifier."
      },
      {
        "id": "stringDelimiter",
        "description": "StetCSS stringDelimiter semantic token modifier."
      },
      {
        "id": "attributeBracket",
        "description": "StetCSS attributeBracket semantic token modifier."
      },
      {
        "id": "classDelimiter",
        "description": "StetCSS classDelimiter semantic token modifier."
      },
      {
        "id": "idDelimiter",
        "description": "StetCSS idDelimiter semantic token modifier."
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "class": [
            "entity.other.attribute-name.class.css"
          ],
          "class.component": [
            "entity.other.attribute-name.class.css"
          ],
          "class.declaration": [
            "entity.other.attribute-name.class.css"
          ],
          "class.selector": [
            "entity.other.attribute-name.class.css"
          ],
          "enumMember": [
            "support.constant.property-value.css"
          ],
          "enumMember.directive": [
            "support.constant.property-value.css"
          ],
          "enumMember.query": [
            "support.constant.property-value.css"
          ],
          "enumMember.selector": [
            "support.constant.parity.css",
            "support.constant.property-value.css"
          ],
          "enumMember.unit": [
            "keyword.other.unit"
          ],
          "property": [
            "support.type.property-name.css"
          ],
          "property.directive": [
            "support.type.property-name.css"
          ],
          "property.query": [
            "support.type.property-name.css"
          ],
          "property.selector": [
            "entity.other.attribute-name.css"
          ],
          "variable": [
            "variable.other.stet-css.css",
            "variable.css"
          ],
          "variable.directive": [
            "variable.parameter.stet-css.css"
          ],
          "variable.selector": [
            "entity.other.attribute-name.id.css"
          ],
          "function": [
            "support.function.misc.css"
          ],
          "number": [
            "constant.numeric.css"
          ],
          "number.query": [
            "constant.numeric.css"
          ],
          "number.selector": [
            "meta.selector.css constant.numeric.css",
            "constant.numeric.css"
          ],
          "string": [
            "string.quoted.css",
            "string.quoted.html"
          ],
          "string.quoted": [
            "string.quoted.css",
            "string.quoted.html"
          ],
          "string.selector": [
            "string.unquoted.attribute-value.css",
            "string.quoted.css"
          ],
          "keyword": [
            "keyword.control.at-rule"
          ],
          "keyword.directive": [
            "keyword.control.at-rule.stet-css.css"
          ],
          "keyword.query": [
            "keyword.control.at-rule"
          ],
          "keyword.selector": [
            "storage.modifier.ignore-case.css"
          ],
          "modifier": [
            "entity.other.attribute-name.pseudo-class.css"
          ],
          "modifier.directive": [
            "storage.modifier.stet-css.css"
          ],
          "modifier.pseudoClass": [
            "entity.other.attribute-name.pseudo-class.css"
          ],
          "modifier.pseudoElement": [
            "entity.other.attribute-name.pseudo-element.css"
          ],
          "operator": [
            "keyword.operator.css"
          ],
          "operator.directive": [
            "punctuation.section.property-list.begin.bracket.curly.css"
          ],
          "operator.important": [
            "keyword.other.important.css",
            "keyword.operator.important.css"
          ],
          "operator.pseudoClass": [
            "entity.other.attribute-name.pseudo-class.css"
          ],
          "operator.pseudoElement": [
            "entity.other.attribute-name.pseudo-element.css"
          ],
          "operator.query": [
            "keyword.operator.css"
          ],
          "operator.selector": [
            "keyword.operator.combinator.css"
          ],
          "operator.unit": [
            "keyword.operator.css"
          ],
          "type": [
            "entity.name.tag.css"
          ],
          "type.selector": [
            "entity.name.tag.css"
          ],
          "string.stringDelimiter": [
            "punctuation.definition.string.begin.css",
            "punctuation.definition.string.end.css",
            "string.quoted.css"
          ],
          "operator.attributeBracket": [
            "punctuation.definition.entity.begin.bracket.square.css",
            "punctuation.definition.entity.end.bracket.square.css"
          ],
          "operator.attributeOperator": [
            "keyword.operator.pattern.css",
            "keyword.operator.css"
          ],
          "operator.blockBrace": [
            "punctuation.section.property-list.begin.bracket.curly.css",
            "punctuation.section.property-list.end.bracket.curly.css"
          ],
          "operator.classDelimiter": [
            "entity.other.attribute-name.class.css punctuation.definition.entity.css"
          ],
          "operator.declarationSeparator": [
            "punctuation.separator.key-value.css"
          ],
          "operator.declarationTerminator": [
            "punctuation.terminator.rule.css"
          ],
          "operator.directiveTerminator": [
            "punctuation.terminator.rule.css"
          ],
          "operator.functionPunctuation": [
            "punctuation.section.function.begin.bracket.round.css",
            "punctuation.section.function.end.bracket.round.css"
          ],
          "operator.idDelimiter": [
            "entity.other.attribute-name.id.css punctuation.definition.entity.css"
          ],
          "operator.pseudoClassDelimiter": [
            "entity.other.attribute-name.pseudo-class.css punctuation.definition.entity.css"
          ],
          "operator.pseudoElementDelimiter": [
            "entity.other.attribute-name.pseudo-element.css punctuation.definition.entity.css"
          ],
          "operator.queryOperator": [
            "keyword.operator.comparison.css",
            "keyword.operator.css"
          ],
          "operator.queryPunctuation": [
            "punctuation.separator.list.comma.css",
            "punctuation.separator.key-value.css",
            "punctuation.definition.parameters.begin.bracket.round.css",
            "punctuation.definition.parameters.end.bracket.round.css",
            "punctuation.section.function.begin.bracket.round.css",
            "punctuation.section.function.end.bracket.round.css"
          ],
          "operator.selectorCombinator": [
            "keyword.operator.combinator.css"
          ],
          "operator.selectorPunctuation": [
            "meta.selector.css punctuation.section.function.begin.bracket.round.css",
            "meta.selector.css punctuation.section.function.end.bracket.round.css",
            "punctuation.section.function.begin.bracket.round.css",
            "punctuation.section.function.end.bracket.round.css"
          ],
          "operator.valueOperator": [
            "keyword.operator.css"
          ],
          "operator.valueSeparator": [
            "punctuation.separator.list.comma.css"
          ]
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "stet-css.directive.injection",
        "path": "./node_modules/@stet-css/language/syntaxes/stet-css.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.css.scss",
          "source.css.less",
          "source.css.postcss"
        ]
      }
    ],
    "configurationDefaults": {
      "css.lint.unknownAtRules": "ignore",
      "scss.lint.unknownAtRules": "ignore",
      "less.lint.unknownAtRules": "ignore"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@stet-css/language": "workspace:^",
    "@stet-css/language-server": "workspace:^",
    "@stet-css/language-service": "workspace:^",
    "@stet-css/project": "workspace:^",
    "@shikijs/langs": "4.2.0",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "vscode-languageclient": "^10.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "peerDependencies": {
    "lightningcss": "^1.32.0",
    "oxc-parser": "^0.129.0",
    "oxc-resolver": "^11.19.1",
    "oxc-transform": "^0.128.0"
  }
}
