{
  "name": "@stet-css/next",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "dev:build": "bun run --cwd playground build",
    "e2e": "vitest run tests/*-e2e.test.ts --no-file-parallelism --mode e2e",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest",
    "bench": "vitest bench"
  },
  "license": "MIT",
  "description": "Next.js integration for StetCSS",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/next#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/next"
  },
  "keywords": [
    "integration",
    "next",
    "nextjs",
    "build tools",
    "static",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/scanner": "workspace:^",
    "@stet-css/integration": "workspace:^",
    "@stet-css/project": "workspace:^",
    "@stet-css/stylesheet": "workspace:^",
    "@stet-css/lexer": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
