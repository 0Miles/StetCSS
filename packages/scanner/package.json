{
  "name": "@stet-css/scanner",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "StetCSS source scanner for static rendering",
  "author": "Miles",
  "homepage": "https://github.com/0Miles/StetCSS/tree/main/packages/scanner#readme",
  "bugs": {
    "url": "https://github.com/0Miles/StetCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Miles/StetCSS.git",
    "directory": "packages/scanner"
  },
  "keywords": [
    "plugin",
    "integration",
    "scanner",
    "static",
    "build tools",
    "css",
    "stetcss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./options": {
      "types": "./dist/options/index.d.ts",
      "import": "./dist/options/index.js",
      "default": "./dist/options/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "./options": [
        "./dist/options/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stet-css/core": "workspace:^",
    "@stet-css/preset": "workspace:^",
    "@stet-css/source": "workspace:^",
    "@stet-css/validator": "workspace:^",
    "@stet-css/schema": "workspace:^",
    "@stet-css/lexer": "workspace:^"
  },
  "devDependencies": {
    "@stet-css/compiler": "workspace:^"
  }
}
